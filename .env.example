# Required: GroqCloud API key for chat + multimodal OCR
GROQ_API_KEY="your-groq-api-key"

# Required for the Thorough-mode current web-grounding demo
TAVILY_API_KEY=""

# Required for final LangSmith tracing/submission evidence
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ExtraCare-AI"

# Legacy LangSmith aliases remain supported
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="ExtraCare-AI"

CHAT_MODEL_NAME="qwen/qwen3.6-27b"
VISION_MODEL_NAME="qwen/qwen3.6-27b"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

MAX_OUTPUT_TOKENS=4096
GROQ_TIMEOUT_SECONDS=60
GROQ_REASONING_FORMAT="hidden"
GROQ_REASONING_EFFORT="none"

MAX_PDF_PAGES=3
DEFAULT_ANALYSIS_MODE=fast
